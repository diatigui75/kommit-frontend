{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@0.0.85",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280,800",
        "--output-dir",
        "testing/qa/.mcp-output"
      ]
    }
  }
}
