# Modèle de .env.dev, lu par `pnpm dev` : app et backend en local.
# Fichier facultatif : sans lui, le code prend la même valeur par défaut, http://localhost:3000.
# URL du backend lancé en local, sans slash final.
VITE_API_URL="http://localhost:3000"

# E2E en local seulement, à mettre dans .env.e2e (ignoré par git) : base où SM-18 fait expirer une session.
# Même valeur que DATABASE_URL du backend.
E2E_DATABASE_URL=""
